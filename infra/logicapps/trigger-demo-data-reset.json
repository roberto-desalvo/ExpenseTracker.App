{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "actions": {
    "HTTP_reconcile_transfers": {
      "inputs": {
        "authentication": {
          "audience": "__API_AUDIENCE__",
          "identity": "__MANAGED_IDENTITY_ID__",
          "type": "ManagedServiceIdentity"
        },
        "method": "POST",
        "uri": "@{variables('backEndBaseUrl')}/api/import/transfers/reconcile"
      },
      "runAfter": {
        "Initialize_variables": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "contentTransfer": {
          "transferMode": "Chunked"
        }
      },
      "type": "Http"
    },
    "HTTP_test_seed": {
      "inputs": {
        "authentication": {
          "audience": "__API_AUDIENCE__",
          "identity": "__MANAGED_IDENTITY_ID__",
          "type": "ManagedServiceIdentity"
        },
        "method": "POST",
        "uri": "@{variables('backEndBaseUrl')}/api/import/test-seed"
      },
      "runAfter": {
        "Initialize_variables": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "contentTransfer": {
          "transferMode": "Chunked"
        }
      },
      "type": "Http"
    },
    "Initialize_variables": {
      "inputs": {
        "variables": [
          {
            "name": "backEndBaseUrl",
            "type": "string",
            "value": "__BACKEND_BASE_URL__"
          }
        ]
      },
      "runAfter": {},
      "type": "InitializeVariable"
    }
  },
  "contentVersion": "1.0.0.0",
  "metadata": {
    "notes": {}
  },
  "outputs": {},
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "W. Europe Standard Time"
      },
      "type": "Recurrence"
    }
  }
}
