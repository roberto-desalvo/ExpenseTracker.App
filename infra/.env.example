# Variabili d'ambiente per il deploy dell'infrastruttura (infra/parameters/prod.bicepparam).
# Copiare in infra/.env (gitignored) e caricarle con infra/scripts/load-env.ps1 (o load-env.sh).
# In CI gli stessi valori sono GitHub variables/secrets (vedi .github/workflows/deploy-infra.yml).

# --- Destinazione ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=westeurope

# --- Entra ID (app registration dell'API) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

# --- SQL server e database esistenti ---
SQL_SERVER_NAME=
SQL_DATABASE_NAME=
# opzionale: vuoto = AZURE_RESOURCE_GROUP
SQL_SERVER_RESOURCE_GROUP=

# --- Login demo ---
DEMO_AUTH_ENABLED=false
# SEGRETO, >= 32 byte (es. openssl rand -base64 48). Vuoto = mantiene quello già in Key Vault.
DEMO_AUTH_SIGNING_KEY=
