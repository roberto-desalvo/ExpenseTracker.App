# Variabili d'ambiente per il deploy dell'infrastruttura (infra/parameters/prod.bicepparam).
# Copiare in infra/.env (gitignored) e caricarle con infra/scripts/load-env.ps1 (o load-env.sh).
# In CI gli stessi valori sono GitHub variables/secrets (vedi .github/workflows/deploy-infra.yml).

# --- Destinazione ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
# location dei metadati del deploy di bootstrap (scope subscription)
AZURE_LOCATION=westeurope

# --- Bootstrap (infra/bootstrap, eseguito in locale da un admin) ---
GITHUB_REPOSITORY=roberto-desalvo/ExpenseTracker.App
# Assegnazione del ruolo Files.Sender (endpoint di import) agli utenti:
# false al primo bootstrap, true dopo il primo deploy dell'infrastruttura.
FILES_SENDER_ASSIGN=false
# UPN separati da virgola a cui assegnare Files.Sender
FILES_SENDER_UPNS=

# --- Frontend ---
# Dominio custom della Static Web App (es. www.expensetracker.lol). Impostarlo solo dopo averlo rimosso
# dalla vecchia Static Web App: un dominio può essere associato a un solo sito alla volta.
CUSTOM_DOMAIN=

# --- SQL server e database esistenti ---
SQL_SERVER_NAME=
SQL_DATABASE_NAME=
# opzionale: vuoto = AZURE_RESOURCE_GROUP
SQL_SERVER_RESOURCE_GROUP=

# --- Import automatico da OneDrive (functions OneDrive_*) ---
# true solo dopo il consenso una tantum con infra/scripts/connect-onedrive.ps1
ONEDRIVE_IMPORT_ENABLED=false
# email dell'utente ExpenseTracker a cui appartengono i dati importati
ONEDRIVE_TARGET_USER_EMAIL=

# --- Login demo ---
DEMO_AUTH_ENABLED=false
# SEGRETO, >= 32 byte (es. openssl rand -base64 48). Vuoto = mantiene quello già in Key Vault.
DEMO_AUTH_SIGNING_KEY=
