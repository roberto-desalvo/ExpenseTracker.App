{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api"
    },
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:00:30",
      "maxDequeueCount": 5
    }
  }
}
