# indirizzo del BE
VITE_EXPENSE_TRACKER_API_BASE_URL=https://your-api-base-url

# Dati App Registration FE
VITE_MSAL_CLIENT_ID=your-entra-app-client-id
VITE_MSAL_TENANT_ID=your-entra-tenant-id

# Endpoint App Registration BE
VITE_MSAL_API_SCOPE=api://your-entra-app-client-id/access_as_user

# Pulsante "Prova la demo" nella pagina di login (login con l'utente di test test@dev.local).
# Attivo di default; richiede DemoAuth__Enabled=true sul BE. Impostare a false per nasconderlo.
# VITE_DEMO_LOGIN_ENABLED=false

# Solo `npm run dev`: bypass dell'autenticazione Entra ID (login con il solo nome utente).
# Attivo di default in sviluppo; impostare a false per usare MSAL anche in locale.
# Richiede DevAuth__Enabled=true nel local.settings.json del BE.
# VITE_DEV_AUTH_BYPASS=false
