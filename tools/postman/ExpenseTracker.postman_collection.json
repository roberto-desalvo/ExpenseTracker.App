                    "reconcile"
                  ],
                  "query": [
                    {
                      "key": "dryRun",
                      "value": "true",
                      "description": "true = mostra i match senza salvarli (default false)"
                    },
                    {
                      "key": "fromDate",
                      "value": "",
                      "description": "Data ISO opzionale, es. 2026-10-01",
                      "disabled": true
                    },
                    {
                      "key": "toDate",
                      "value": "",
                      "description": "Data ISO opzionale; senza orario include tutto il giorno",
                      "disabled": true
                    }
                  ]
                },
                "description": "Non usa l'identità del chiamante: cerca tra i movimenti non collegati di tutti gli utenti (ognuno solo tra i propri conti) le coppie che formano un trasferimento (regole `TransferMatching`, IBAN dei conti nella descrizione, movimenti in categoria Money transfers; tolleranza 3 giorni) e le collega con un `Transfer`. Risposta: `200 { dryRun, usersProcessed, examinedTransactions, linkedTransfers, matchedByRule, matchedByIban, matchedByCategory, ambiguousSkipped, pairs: [...] }`."
              }
            }
          ]
        }
