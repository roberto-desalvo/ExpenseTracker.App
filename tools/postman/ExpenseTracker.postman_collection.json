    {
      "name": "Import",
      "description": "`api/import` \u2014 richiede il ruolo applicativo **Files.Sender** nel token. Tutti gli endpoint accettano `?importAll=true` per reimportare anche le righe gi\u00e0 note. Risposta: `200 { importedCount }` oppure `400 { errors: [...] }`.",
      "item": [
        {
          "name": "Excel (legacy)",
          "description": "Import Excel multi-sheet.",
          "item": [
            {
              "name": "Import_Excel",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/import/excel?importAll={{importAll}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "import",
                    "excel"
                  ],
                  "query": [
                    {
                      "key": "importAll",
                      "value": "{{importAll}}"
                    }
                  ]
                },
                "description": "Import Excel multipart. Selezionare il file nel campo `file` (form-data).",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "type": "file",
                      "src": ""
                    }
                  ]
                }
              }
            },
            {
              "name": "Import_ExcelBase64",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/import/excel/base64?importAll={{importAll}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "import",
                    "excel",
                    "base64"
                  ],
                  "query": [
                    {
                      "key": "importAll",
                      "value": "{{importAll}}"
                    }
                  ]
                },
                "description": "Import Excel con contenuto base64 nel body JSON.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"base64Content\": \"<BASE64>\",\n  \"fileName\": \"import.xlsx\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Import_ExcelStream",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/octet-stream"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/import/excel/stream?importAll={{importAll}}",
                  "host": [
                    "{{baseUrl}}"
